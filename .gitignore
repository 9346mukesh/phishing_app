# Phishing Detection System - .gitignore

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/

# === Virtual Environments ===
venv/
.venv/
.env
.env.local

# === IDE & Editors ===
.vscode/
.idea/
*.swp
*.swo
*~
*.code-workspace

# === Testing ===
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/

# === OS ===
.DS_Store
Thumbs.db

# === Data & Models ===
data/
*.csv
!requirements*.txt
*.joblib
models/metrics.json

# === MLOps Runtime ===
mlruns/
mlflow.db
reports/
!reports/.gitkeep
dvc.lock

# === Temporary ===
*.log
logs/
tmp/
temp/
