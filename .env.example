# Application Configuration
ENVIRONMENT=development
DEBUG=true
APP_NAME="Phishing Detection API"
APP_VERSION="1.0.0"

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
CORS_ORIGINS=*

# Model Configuration
MODEL_PATH=models/phishing_rf_model.pkl
SCALER_PATH=models/scaler.pkl
# MODEL_CHECKSUM=abc123def456...  # Set in production
# SCALER_CHECKSUM=def456ghi789...  # Set in production

# Security
# API_KEY=your-secret-api-key  # Set in production
ENABLE_RATE_LIMITING=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Feature Extraction
URL_VALIDATION_ENABLED=true
DNS_LOOKUP_TIMEOUT=2.0
DNS_LOOKUP_ENABLED=true

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Performance
REQUEST_TIMEOUT=30.0
MODEL_CACHE_ENABLED=true
